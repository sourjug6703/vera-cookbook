        {
          "id": "/page/11/SectionHeader/1",
          "block_type": "SectionHeader",
          "html": "<h2>Wiener Schnitzel - Breaded veal scallops - Řízky</h2>",
          "polygon": [
            [
              402.0,
              139.0
            ],
            [
              1063.5,
              139.0
            ],
            [
              1063.5,

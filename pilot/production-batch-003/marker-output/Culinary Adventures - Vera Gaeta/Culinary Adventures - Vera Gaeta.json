        {
          "id": "/page/10/ListGroup/8",
          "block_type": "ListGroup",
          "html": "<ul style=\"list-style-type: none;\">\n<li>• 6 veal chops</li>\n<li>• 1/2 cup flour</li>\n<li>• 2 eggs</li>\n<li>• 1/3 cup milk</li>\n<li>• 1 cup bread crumbs</li>\n<li>• 1 cup vegetable oil</li>\n<li>• salt</li>\n</ul>",
          "polygon": [
            [
              124.5,
              771.75
            ],
            [
              355.5,
              771.75
            ],
            [
              355.5,

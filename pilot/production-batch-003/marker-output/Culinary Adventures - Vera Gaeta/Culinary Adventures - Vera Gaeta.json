            "3": "/page/12/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/12/Text/6",
          "block_type": "Text",
          "html": "<p>Skim fat from the pan drippings, strain some over the roast, serve the rest in a saucedish.</p>",
          "polygon": [
            [
              546.0,
              432.0
            ],
            [
              1318.5,

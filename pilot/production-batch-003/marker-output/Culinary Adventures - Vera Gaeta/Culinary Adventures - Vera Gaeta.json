        {
          "id": "/page/12/ListGroup/10",
          "block_type": "ListGroup",
          "html": "<ul>\n<li>• 3-4 lbs. fresh ham, boned and skinned</li>\n<li>• 4 slices bacon</li>\n<li>• 6 tablespoons butter</li>\n<li>• 2 carrots</li>\n<li>• 1 celery root</li>\n<li>• 1 parsnip</li>\n<li>• 3 bay leaves, thyme, whole allspice, whole black pepper</li>\n<li>• 1 lemon</li>\n<li>• 1-1/2 cups sour cream</li>\n<li>• 2 tablespoons flour</li>\n<li>• 1-1/2 cups chicken stock or water</li>\n<li>• salt</li>\n</ul>",
          "polygon": [

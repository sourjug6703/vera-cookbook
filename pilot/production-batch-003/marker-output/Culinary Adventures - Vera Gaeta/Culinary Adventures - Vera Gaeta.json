        {
          "id": "/page/11/ListGroup/5",
          "block_type": "ListGroup",
          "html": "<ul>\n<li>⇒ This is the correct way to prepare Wiener Schnitzels, a very popular meal in Bohemia.<br/>Thinly sliced boneless pork chops, beef tenderloin slices, boned and skinned chicken breast or cutlets may be prepared in the same manner.</li>\n</ul>",
          "polygon": [
            [
              549.0,
              402.0
            ],
            [
              1294.5,
              402.0
            ],
            [
              1294.5,
              495.99999999999994
